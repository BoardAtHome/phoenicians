{
  "name": "phoenicians",
  "version": "0.11.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @phoenicians/server & npm run dev -w @phoenicians/client",
    "build": "npm run build -w @phoenicians/client",
    "start": "npm start -w @phoenicians/server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}
